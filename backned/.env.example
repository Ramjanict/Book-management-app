DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=5000

# Used by `npm run seed`. Public registration cannot create an admin.
ADMIN_EMAIL="admin@ramjan.library"
ADMIN_PASSWORD="change-me"
ADMIN_NAME="Library Admin"
# Password for the demo authors and readers. Defaults to Library123.
SEED_PASSWORD="Library123"
